<?xml version="1.0" encoding="UTF-8"?><xsd:schema xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:inngrepsfrinatur="https://kart.miljodirektoratet.no/geoserver/inngrepsfrinatur" xmlns:wfs="http://www.opengis.net/wfs/2.0" xmlns:xsd="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" targetNamespace="https://kart.miljodirektoratet.no/geoserver/inngrepsfrinatur">
  <xsd:import namespace="http://www.opengis.net/gml/3.2" schemaLocation="https://kart.miljodirektoratet.no/geoserver/schemas/gml/3.2.1/gml.xsd"/>
  <xsd:complexType name="statusType">
    <xsd:complexContent>
      <xsd:extension base="gml:AbstractFeatureType">
        <xsd:sequence>
          <xsd:element maxOccurs="1" minOccurs="1" name="inonid" nillable="false" type="xsd:long"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="vsone" nillable="true" type="xsd:string"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="arealkm2" nillable="true" type="xsd:float"/>
          <xsd:element maxOccurs="1" minOccurs="0" name="geom" nillable="true" type="gml:GeometryPropertyType"/>
        </xsd:sequence>
      </xsd:extension>
    </xsd:complexContent>
  </xsd:complexType>
  <xsd:element name="status" substitutionGroup="gml:AbstractFeature" type="inngrepsfrinatur:statusType"/>
</xsd:schema>
